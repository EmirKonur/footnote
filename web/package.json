{
  "name": "footnote-web",
  "version": "0.1.0",
  "private": true,
  "description": "Footnote web client: collections, document viewer, and cited answers.",
  "author": "Emir Konur",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "dev": "next dev --port 4411",
    "build": "next build",

# Copy to .env. The Makefile exports everything here to the API and web processes, and
# docker compose reads it too. Every variable is optional.

# Claude. Without a key the app runs in retrieval-only mode: it ingests, searches, and
# shows ranked passages. Profiles from `ant auth login` are picked up as well.
ANTHROPIC_API_KEY=

# Answering model and its effort (low | medium | high | xhigh | max).
FOOTNOTE_MODEL=claude-opus-5-5
FOOTNOTE_EFFORT=medium
FOOTNOTE_MAX_TOKENS=16000
# Model used as the judge by `make eval-generation`.
FOOTNOTE_JUDGE_MODEL=claude-opus-5-5

# Development aids. FOOTNOTE_FAKE_LLM=fixtures answers with sentences picked by word
# overlap (no model call; the UI labels these answers). FOOTNOTE_RETRIEVAL_ONLY=true
# forces retrieval-only mode even when credentials exist.
FOOTNOTE_FAKE_LLM=off
FOOTNOTE_RETRIEVAL_ONLY=false

# Storage and retrieval.
FOOTNOTE_DATA_DIR=data
FOOTNOTE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FOOTNOTE_TOP_K=8

# Server.
FOOTNOTE_HOST=127.0.0.1
FOOTNOTE_PORT=4410
FOOTNOTE_CORS_ORIGINS=["http://localhost:4411","http://127.0.0.1:4411"]
FOOTNOTE_LOG_FORMAT=console

# Where the web app's browser code finds the API.
FOOTNOTE_API_URL=http://localhost:4410
